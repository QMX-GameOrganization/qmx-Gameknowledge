---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
  getDocCollectionKey,
  getDocDate,
  getDocHref,
  getDocSeries,
  getDocVisualKey,
  isPublicDoc,
} from '../../lib/content';

const labels: Record<string, string> = {
  'ue专栏': 'UE 专栏 · 运动系统',
  'csharp速通': 'C# 速通',
  'csharp与unity内存基础': 'C# 与 Unity 内存基础',
  'csharp底层专栏': 'C# 底层专栏',
  'unity-job与burst': 'Unity Job、Burst 与 Entities',
  'ecs学习': 'ECS 学习与工厂游戏',
  '认识unity': '认识 Unity',
  'minecraft源码学习': 'Minecraft 源码学习',
  '游戏框架设计专栏': '游戏框架设计专栏',
  'unity热更新专栏': 'Unity 热更新专栏',
  'git使用指南': 'Git 使用指南',
  八股: '基础知识速查',
  自我忏悔: '学习规划与复盘',
  projects: '项目文章',
  guide: '使用指南',
};

export async function getStaticPaths() {
  const allDocs = (await getCollection('docs')).filter(isPublicDoc);
  const keys = [...new Set(allDocs.map(getDocCollectionKey))];
  return keys.map((slug) => ({ params: { slug }, props: { slug } }));
}

const slug = Astro.props.slug as string;
const allDocs = (await getCollection('docs')).filter(isPublicDoc);
const docs = allDocs.filter((doc) => getDocCollectionKey(doc) === slug).sort((a, b) => (a.data.sidebar.order ?? 999) - (b.data.sidebar.order ?? 999) || a.id.localeCompare(b.id, 'zh-CN', { numeric: true }));
const title = labels[slug] ?? getDocSeries(docs[0] as never) ?? slug;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lead = docs.find((doc) => doc.data.cover) ?? docs[0];
const visualKey = getDocVisualKey(lead as never);
const description = lead?.data.description ?? '按阅读路径整理的专题文章。';
const frontmatter = {
  title,
  description,
  template: 'doc',
  sidebar: { hidden: true },
  prev: false,
  next: false,
};

function dateLabel(doc: (typeof docs)[number]) {
  const date = getDocDate(doc);
  return date ? date.toLocaleDateString('zh-CN') : '长期维护';
}
---

<StarlightPage frontmatter={frontmatter}>
  <div class:list={['qmx-series-page', 'cover-' + visualKey]}>
    <header class="qmx-series-hero">
      <div class="qmx-series-hero__backdrop" aria-hidden="true">
        {lead?.data.cover ? <img src={lead.data.cover} alt="" /> : <span>{title}</span>}
      </div>
      <div class="qmx-series-hero__content">
        <div class="qmx-series-breadcrumb"><a href={base + '/'}>知识库</a><span aria-hidden="true">/</span><span>专题</span></div>
        <span class="qmx-series-kicker">SERIES / 专题空间</span>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="qmx-series-stats"><span><strong>{docs.length}</strong> 篇文章</span><span>按顺序阅读</span><span>持续整理</span></div>
      </div>
    </header>

    <div class="qmx-series-layout">
      <main>
        <section id="reading-path" class="series-section" aria-labelledby="reading-path-title">
          <div class="section-heading"><div><span class="eyebrow">READING PATH / 阅读路径</span><h2 id="reading-path-title">从这里开始</h2></div><p>专题页负责发现和选择文章，进入文章后将切换到沉浸式阅读。</p></div>
          <div class="series-path-grid">
            {docs.slice(0, 4).map((doc, index) => <a href={getDocHref(doc, base)} class="series-path-card">
              <span>0{index + 1}</span>
              <strong>{doc.data.title}</strong>
              <small>{doc.data.description ?? '进入文章查看详细内容。'}</small>
            </a>)}
          </div>
        </section>

        <section id="all-articles" class="series-section" aria-labelledby="all-articles-title">
          <div class="section-heading"><div><span class="eyebrow">ALL ARTICLES / 全部文章</span><h2 id="all-articles-title">专题文章</h2></div><p>按当前专题目录顺序排列。</p></div>
          <div class="series-article-list">
            {docs.map((doc, index) => <a class="series-article-item" href={getDocHref(doc, base)}>
              <span class="series-article-item__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="series-article-item__main"><strong>{doc.data.title}</strong><small>{doc.data.description ?? '查看文章内容。'}</small></span>
              <time datetime={getDocDate(doc)?.toISOString()}>{dateLabel(doc)}</time>
              <span aria-hidden="true">↗</span>
            </a>)}
          </div>
        </section>
      </main>
      <aside class="qmx-series-aside">
        <div class="qmx-series-aside__card">
          <span class="eyebrow">ABOUT THIS SERIES</span>
          <strong>{title}</strong>
          <p>从专题入口开始选择文章。每篇文章保留右侧本页目录，左侧专题树可以随时从菜单按钮打开。</p>
          <a href={base + '/'}>浏览其他专题 <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </div>
</StarlightPage>

---
import { themes } from '../themes.mjs';

// 站点 base，末尾保证带斜杠，传给主题特效去加载自定义素材。
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// 暗色、亮色分组显示，方便在十几个主题里快速找到想要的明暗类型。
const groups = [
  { label: '暗色', items: themes.filter((theme) => theme.mode === 'dark') },
  { label: '亮色', items: themes.filter((theme) => theme.mode === 'light') },
];
---

<span class="qmx-theme-select-group" data-qmx-base={base}>
  <label class="qmx-theme-select">
    <span class="qmx-theme-select__label">主题</span>
    <select data-qmx-theme-select aria-label="选择主题">
      {groups.map((group) => (
        <optgroup label={group.label}>
          {group.items.map((theme) => <option value={theme.id}>{theme.label}</option>)}
        </optgroup>
      ))}
    </select>
  </label>
  <button type="button" class="qmx-ai-settings-btn" data-qmx-ai-settings title="划词问 AI 的设置（接口与 Key）">AI</button>
  <!-- 只有带特效的主题才会显示这两个开关，见 fx.css -->
  <span class="qmx-fx-controls">
    <button type="button" data-qmx-fx-toggle aria-pressed="true" title="开关当前主题的动态特效">特效</button>
    <button type="button" data-qmx-sound-toggle aria-pressed="false" title="开关音效，默认关闭">音效</button>
  </span>
</span>

<script>
  // 主题的恢复与持久化由 astro.config.mjs 注入到 <head> 的脚本完成（window.QMXTheme）。
  // 这里只负责：下拉框与当前主题保持同步、响应用户切换、按需加载初音桌宠。
  import { initFx } from '../fx/index';
  import { initAskAi } from '../ai/ask-ai';

  type MikuPet = { remove?: () => void };
  const w = window as unknown as {
    QMXTheme?: { apply(id: string): string };
    Miku?: new () => MikuPet;
    qmxMiku?: MikuPet | null;
  };

  const MIKU_SRC = 'https://cdn.jsdelivr.net/gh/samiulalim1/Hatsune-Miku-Web-Pet@v1.0.0/miku.min.js';
  const root = document.documentElement;
  let mikuLoading = false;

  function syncSelects(id: string) {
    document
      .querySelectorAll<HTMLSelectElement>('select[data-qmx-theme-select]')
      .forEach((select) => { select.value = id; });
  }

  function createMiku() {
    if (root.dataset.qmxTheme === 'miku' && w.Miku && !w.qmxMiku) w.qmxMiku = new w.Miku();
  }

  function syncMiku(id: string) {
    if (id !== 'miku') {
      w.qmxMiku?.remove?.();
      w.qmxMiku = null;
      return;
    }
    if (w.qmxMiku || mikuLoading) return;
    // 桌宠会持续播放动画，系统要求减少动态效果时不加载。
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (w.Miku) {
      createMiku();
      return;
    }
    mikuLoading = true;
    const script = document.createElement('script');
    script.dataset.qmxMikuScript = 'true';
    script.src = MIKU_SRC;
    script.onload = () => { mikuLoading = false; createMiku(); };
    // CDN 访问失败时静默跳过，不影响页面阅读。
    script.onerror = () => { mikuLoading = false; script.remove(); };
    document.head.appendChild(script);
  }

  document.addEventListener('qmx-themechange', (event) => {
    const { id } = (event as CustomEvent<{ id: string }>).detail;
    syncSelects(id);
    syncMiku(id);
  });

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLSelectElement && target.hasAttribute('data-qmx-theme-select')) {
      w.QMXTheme?.apply(target.value);
    }
  });

  const initial = root.dataset.qmxTheme ?? 'starry';
  syncSelects(initial);
  syncMiku(initial);

  // 主题专属的动态特效(星夜的星空、罗德岛的桌宠)，见 src/fx/。
  const base = document.querySelector<HTMLElement>('[data-qmx-base]')?.dataset.qmxBase ?? '/';
  initFx(base);

  // 划词问 AI，见 src/ai/。只在浏览器里运行，key 只存本机。
  initAskAi();
</script>

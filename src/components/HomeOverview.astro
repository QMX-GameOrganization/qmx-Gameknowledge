---
import { getCollection } from 'astro:content';
import {
  getDocDate,
  getDocHref,
  getDocSeries,
  getDocVisualKey,
  isPublicDoc,
} from '../lib/content';
import '../styles/home.css';

const docs = (await getCollection('docs')).filter(isPublicDoc);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels: Record<string, string> = {
  'ue专栏': 'UE 专栏 · 运动系统',
  'csharp速通': 'C# 速通',
  'csharp与unity内存基础': 'C# 与 Unity 内存基础',
  'csharp底层专栏': 'C# 底层专栏',
  'unity-job与burst': 'Unity Job、Burst 与 Entities',
  'ecs学习': 'ECS 学习与工厂游戏',
  '认识unity': '认识 Unity',
  'minecraft源码学习': 'Minecraft 源码学习',
  '游戏框架设计专栏': '游戏框架设计专栏',
  'unity热更新专栏': 'Unity 热更新专栏',
  'git使用指南': 'Git 使用指南',
  八股: '基础知识速查',
  自我忏悔: '学习规划与复盘',
  projects: '项目文章',
  guide: '使用指南',
};
const categories = [
  { id: 'language', title: '语言与内存', description: 'C#、面向对象、运行时与内存管理。', folders: ['csharp速通', 'csharp与unity内存基础', 'csharp底层专栏', '面向对象串讲'] },
  { id: 'unity', title: 'Unity 与 ECS', description: '编辑器基础、Job、Burst、Entities 与工厂游戏实现。', folders: ['unity-job与burst', 'ecs学习', '认识unity'] },
  { id: 'gameplay', title: '游戏框架与玩法', description: '从角色输入到规则裁决、动作执行与状态反馈。', folders: ['游戏框架设计专栏'] },
  { id: 'unreal', title: 'Unreal Engine', description: '从引擎源码到 GASP 蓝图，研究角色运动动画。', folders: ['ue专栏'] },
  { id: 'source', title: '源码研究', description: 'Minecraft 世界生成与消失的光芒系统拆解。', folders: ['minecraft源码学习', '消失的光芒逆向学习'] },
  { id: 'engineering', title: '热更新与工程', description: '资源管理、AssetBundle、Addressables 与代码热更。', folders: ['unity热更新专栏'] },
  { id: 'reference', title: '工具与知识速查', description: 'Git 协作、开发工具、基础知识与学习记录。', folders: ['git使用指南', '工具', '八股', '自我忏悔'] },
  { id: 'projects', title: '项目与使用指南', description: '项目介绍、实践记录以及知识库的使用与维护。', folders: ['projects', 'guide'] },
];

const buckets = new Map<string, typeof docs>();
for (const doc of docs) {
  const parts = doc.id.split('/');
  const folder = parts[0] === 'knowledge' ? parts[1] : parts[0];
  const entries = buckets.get(folder) ?? [];
  entries.push(doc);
  buckets.set(folder, entries);
}
const assigned = new Set(categories.flatMap((category) => category.folders));
for (const folder of buckets.keys()) {
  if (!assigned.has(folder)) categories.find((category) => category.id === 'reference')!.folders.push(folder);
}

const displaySeries = (doc: (typeof docs)[number]) => {
  const series = getDocSeries(doc);
  return labels[series.toLowerCase()] ?? labels[series] ?? series;
};
const sortByDate = (a: (typeof docs)[number], b: (typeof docs)[number]) => {
  const dateA = getDocDate(a)?.getTime() ?? 0;
  const dateB = getDocDate(b)?.getTime() ?? 0;
  return dateB - dateA || a.id.localeCompare(b.id, 'zh-CN', { numeric: true });
};
const fallbackFeatured = docs.filter((doc) => doc.id.startsWith('projects/') || doc.id.includes('/目录'));
const featured = [...docs.filter((doc) => doc.data.featured).sort(sortByDate), ...fallbackFeatured.sort(sortByDate)]
  .filter((doc, index, entries) => entries.findIndex((item) => item.id === doc.id) === index)
  .slice(0, 4);
const latest = [...docs].sort(sortByDate).slice(0, 6);
const sections = categories.map((category) => ({
  ...category,
  topics: category.folders.filter((folder) => buckets.has(folder)).map((folder) => {
    const entries = buckets.get(folder)!.sort((a, b) => (a.data.sidebar.order ?? 999) - (b.data.sidebar.order ?? 999) || a.id.localeCompare(b.id, 'zh-CN', { numeric: true }));
    return {
      title: labels[folder] ?? folder,
      collectionKey: folder,
      entries: entries.map((entry) => ({ title: entry.data.title, href: getDocHref(entry, base) })),
    };
  }),
}));
const randomLinks = docs.map((doc) => ({ href: getDocHref(doc, base), title: doc.data.title, series: displaySeries(doc) }));

function coverStyle(doc: (typeof docs)[number]) {
  return doc.data.cover ? '--qmx-cover-image: url("' + doc.data.cover + '")' : undefined;
}
function formatDate(doc: (typeof docs)[number]) {
  const date = getDocDate(doc);
  return date ? date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }) : '持续整理';
}
---

<div class="qmx-home" data-home-shell data-random-links={JSON.stringify(randomLinks)}>
  <section class="qmx-home-hero" aria-labelledby="home-title">
    <div class="qmx-home-hero__copy">
      <span class="eyebrow">QMX / GAME KNOWLEDGE</span>
      <h1 id="home-title">把分散的经验，整理成可以继续阅读的路径。</h1>
      <p>这里记录游戏开发、引擎技术、框架设计和项目实践。先选一个内容分区，再进入完整专题。</p>
    </div>
    <div class="qmx-home-hero__index" aria-label="知识库概况">
      <div><strong>{docs.length}</strong><span>篇文章</span></div>
      <div><strong>{buckets.size}</strong><span>个专题</span></div>
      <div><strong>{featured.length}</strong><span>精选入口</span></div>
      <p>选择分区<br />再开始阅读</p>
    </div>
  </section>

  <section class="home-workspace" id="home-workspace" aria-labelledby="workspace-title">
    <div class="workspace-heading">
      <div><span class="eyebrow">DISCOVER / 内容入口</span><h2 id="workspace-title">选择一个入口开始</h2></div>
      <p>首页只负责分区和跳转，文章细节进入专题后再展开。</p>
    </div>
    <div class="workspace-layout">
      <nav class="workspace-tabs" aria-label="首页内容分区">
        <button type="button" data-home-tab="topics" aria-controls="home-panel-topics" aria-selected="true"><strong>专题</strong><small>按主题浏览</small><span>08</span></button>
        <button type="button" data-home-tab="featured" aria-controls="home-panel-featured" aria-selected="false"><strong>精选</strong><small>适合先读</small><span>{featured.length.toString().padStart(2, '0')}</span></button>
        <button type="button" data-home-tab="latest" aria-controls="home-panel-latest" aria-selected="false"><strong>最近整理</strong><small>查看新内容</small><span>06</span></button>
        <button type="button" data-home-tab="random" aria-controls="home-panel-random" aria-selected="false"><strong>随机跳转</strong><small>换一篇阅读</small><span>↗</span></button>
      </nav>

      <div class="workspace-panels">
        <section class="workspace-panel is-active" id="home-panel-topics" data-home-panel="topics" aria-labelledby="topics-panel-title">
          <div class="panel-heading"><div><span class="eyebrow">TOPICS / 专题地图</span><h3 id="topics-panel-title">先选内容区域</h3></div><span>{buckets.size} 个专题</span></div>
          <div class="topic-category-grid">
            {sections.map((section, index) => <article class="topic-category-card">
              <div class="topic-category-card__top"><span>0{index + 1}</span><strong>{section.topics.reduce((count, topic) => count + topic.entries.length, 0)} 篇</strong></div>
              <h4>{section.title}</h4>
              <p>{section.description}</p>
              <div class="topic-category-card__details">
                {section.topics.slice(0, 3).map((topic) => <a href={base + '/series/' + encodeURIComponent(topic.collectionKey) + '/'}><strong>{topic.title}</strong><small>{topic.entries[0]?.title ?? '进入专题查看章节'}</small></a>)}
              </div>
            </article>)}
          </div>
        </section>

        <section class="workspace-panel" id="home-panel-featured" data-home-panel="featured" aria-labelledby="featured-panel-title" hidden>
          <div class="panel-heading"><div><span class="eyebrow">START HERE / 从这里开始</span><h3 id="featured-panel-title">精选内容</h3></div><span>适合首次进入</span></div>
          <div class="featured-grid">
            {featured.map((doc, index) => <a class:list={['feature-card', { 'feature-card--lead': index === 0 }]} href={getDocHref(doc, base)}>
              <div class:list={['content-cover', 'cover-' + getDocVisualKey(doc)]} style={coverStyle(doc)}>
                {doc.data.cover ? <img src={doc.data.cover} alt={doc.data.coverAlt ?? ''} loading="lazy" /> : <span aria-hidden="true">{displaySeries(doc)}</span>}
                <span class="content-cover__label">{index === 0 ? '编辑推荐' : '精选入口'}</span>
              </div>
              <div class="feature-card__body"><div class="card-meta"><span>{displaySeries(doc)}</span><span>{formatDate(doc)}</span></div><h4>{doc.data.title}</h4>{doc.data.description && <p>{doc.data.description}</p>}<span class="card-link">开始阅读 <span aria-hidden="true">↗</span></span></div>
            </a>)}
          </div>
        </section>

        <section class="workspace-panel" id="home-panel-latest" data-home-panel="latest" aria-labelledby="latest-panel-title" hidden>
          <div class="panel-heading"><div><span class="eyebrow">LATEST / 最近整理</span><h3 id="latest-panel-title">最近值得继续读的内容</h3></div><span>按日期排序</span></div>
          <div class="latest-list">
            {latest.map((doc) => <a class="latest-item" href={getDocHref(doc, base)}><span class:list={['latest-item__mark', 'cover-' + getDocVisualKey(doc)]} aria-hidden="true"></span><span class="latest-item__main"><strong>{doc.data.title}</strong><small>{displaySeries(doc)} · {doc.data.description ?? '查看文章内容与相关资料。'}</small></span><time datetime={getDocDate(doc)?.toISOString()}>{formatDate(doc)}</time></a>)}
          </div>
        </section>

        <section class="workspace-panel random-panel" id="home-panel-random" data-home-panel="random" aria-labelledby="random-panel-title" hidden>
          <div class="random-panel__copy"><span class="eyebrow">RANDOM / 随机跳转</span><h3 id="random-panel-title">让知识库替你选一篇</h3><p>适合不知道从哪里开始时使用。每次点击都会从现有文章中换一个入口。</p><div class="random-panel__actions"><a id="random-target" class="random-panel__target" href={featured[0] ? getDocHref(featured[0], base) : base + '/'}><strong>{featured[0]?.data.title ?? '打开一篇文章'}</strong><small>{featured[0] ? displaySeries(featured[0]) : '知识库'}</small></a><button type="button" id="random-again">换一篇 <span aria-hidden="true">↗</span></button></div></div>
          <div class="random-panel__mark" aria-hidden="true">↗</div>
        </section>
      </div>
    </div>
  </section>
</div>

<script>
  const shell = document.querySelector('[data-home-shell]');
  if (shell) {
    const tabs = [...shell.querySelectorAll('[data-home-tab]')];
    const panels = [...shell.querySelectorAll('[data-home-panel]')];
    const selectPanel = (key, updateHash = true) => {
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.homeTab === key)));
      panels.forEach((panel) => {
        const active = panel.dataset.homePanel === key;
        panel.classList.toggle('is-active', active);
        panel.toggleAttribute('hidden', !active);
      });
      if (updateHash) history.replaceState(null, '', `${location.pathname}${location.search}#home-panel-${key}`);
    };
    const hashKey = location.hash.match(/^#home-panel-(topics|featured|latest|random)$/)?.[1] ?? 'topics';
    selectPanel(hashKey, false);
    tabs.forEach((tab) => tab.addEventListener('click', () => selectPanel(tab.dataset.homeTab)));
    window.addEventListener('hashchange', () => {
      const key = location.hash.match(/^#home-panel-(topics|featured|latest|random)$/)?.[1];
      if (key) selectPanel(key, false);
    });

    const links = JSON.parse(shell.dataset.randomLinks ?? '[]');
    const target = shell.querySelector('#random-target');
    const again = shell.querySelector('#random-again');
    again?.addEventListener('click', () => {
      if (!links.length || !target) return;
      const item = links[Math.floor(Math.random() * links.length)];
      target.href = item.href;
      target.querySelector('strong').textContent = item.title;
      target.querySelector('small').textContent = item.series;
    });
  }
</script>

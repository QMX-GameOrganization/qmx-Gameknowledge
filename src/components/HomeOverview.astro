---
import { getCollection } from 'astro:content';
import {
  getDocDate,
  getDocHref,
  getDocSeries,
  getDocVisualKey,
  isPublicDoc,
} from '../lib/content';
import '../styles/home.css';

const docs = (await getCollection('docs')).filter(isPublicDoc);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels: Record<string, string> = {
  'ue专栏': 'UE 专栏 · 运动系统',
  'csharp速通': 'C# 速通',
  'csharp与unity内存基础': 'C# 与 Unity 内存基础',
  'csharp底层专栏': 'C# 底层专栏',
  'unity-job与burst': 'Unity Job、Burst 与 Entities',
  'ecs学习': 'ECS 学习与工厂游戏',
  '认识unity': '认识 Unity',
  'minecraft源码学习': 'Minecraft 源码学习',
  '游戏框架设计专栏': '游戏框架设计专栏',
  'unity热更新专栏': 'Unity 热更新专栏',
  'git使用指南': 'Git 使用指南',
  八股: '基础知识速查',
  自我忏悔: '学习规划与复盘',
  projects: '项目文章',
  guide: '使用指南',
};
const categories = [
  { id: 'language', title: '语言与内存', description: 'C#、面向对象、运行时与内存管理。', folders: ['csharp速通', 'csharp与unity内存基础', 'csharp底层专栏', '面向对象串讲'] },
  { id: 'unity', title: 'Unity 与 ECS', description: '编辑器基础、Job、Burst、Entities 与工厂游戏实现。', folders: ['unity-job与burst', 'ecs学习', '认识unity'] },
  { id: 'gameplay', title: '游戏框架与玩法', description: '从角色输入到规则裁决、动作执行与状态反馈。', folders: ['游戏框架设计专栏'] },
  { id: 'unreal', title: 'Unreal Engine', description: '从引擎源码到 GASP 蓝图，研究角色运动动画。', folders: ['ue专栏'] },
  { id: 'source', title: '源码研究', description: 'Minecraft 世界生成与消失的光芒系统拆解。', folders: ['minecraft源码学习', '消失的光芒逆向学习'] },
  { id: 'engineering', title: '热更新与工程', description: '资源管理、AssetBundle、Addressables 与代码热更。', folders: ['unity热更新专栏'] },
  { id: 'reference', title: '工具与知识速查', description: 'Git 协作、开发工具、基础知识与学习记录。', folders: ['git使用指南', '工具', '八股', '自我忏悔'] },
  { id: 'projects', title: '项目与使用指南', description: '项目介绍、实践记录以及知识库的使用与维护。', folders: ['projects', 'guide'] },
];

const buckets = new Map<string, typeof docs>();
for (const doc of docs) {
  const parts = doc.id.split('/');
  const folder = parts[0] === 'knowledge' ? parts[1] : parts[0];
  const entries = buckets.get(folder) ?? [];
  entries.push(doc);
  buckets.set(folder, entries);
}
const assigned = new Set(categories.flatMap((category) => category.folders));
for (const folder of buckets.keys()) {
  if (!assigned.has(folder)) categories.find((category) => category.id === 'reference')!.folders.push(folder);
}

const displaySeries = (doc: (typeof docs)[number]) => {
  const series = getDocSeries(doc);
  return labels[series.toLowerCase()] ?? labels[series] ?? series;
};
const sortByDate = (a: (typeof docs)[number], b: (typeof docs)[number]) => {
  const dateA = getDocDate(a)?.getTime() ?? 0;
  const dateB = getDocDate(b)?.getTime() ?? 0;
  return dateB - dateA || a.id.localeCompare(b.id, 'zh-CN', { numeric: true });
};
const fallbackFeatured = docs.filter((doc) => doc.id.startsWith('projects/') || doc.id.includes('/目录'));
const featured = [...docs.filter((doc) => doc.data.featured).sort(sortByDate), ...fallbackFeatured.sort(sortByDate)]
  .filter((doc, index, entries) => entries.findIndex((item) => item.id === doc.id) === index)
  .slice(0, 4);
const latest = [...docs].sort(sortByDate).slice(0, 6);
const sections = categories.map((category) => {
  const topics = category.folders.filter((folder) => buckets.has(folder)).map((folder) => {
    const entries = buckets.get(folder)!.sort((a, b) => (a.data.sidebar.order ?? 999) - (b.data.sidebar.order ?? 999) || a.id.localeCompare(b.id, 'zh-CN', { numeric: true }));
    return {
      title: labels[folder] ?? folder,
      collectionKey: folder,
      entries: entries.map((entry) => ({
        title: entry.data.title,
        href: getDocHref(entry, base),
        cover: entry.data.cover,
        coverAlt: entry.data.coverAlt ?? '',
        visualKey: getDocVisualKey(entry),
      })),
    };
  });
  return { ...category, topics, articleCount: topics.reduce((count, topic) => count + topic.entries.length, 0) };
});
const topicCards = sections.flatMap((section) => section.topics.map((topic) => ({ ...topic, sectionId: section.id, sectionTitle: section.title })));
const randomLinks = docs.map((doc) => ({ href: getDocHref(doc, base), title: doc.data.title, series: displaySeries(doc) }));

function coverStyle(doc: (typeof docs)[number]) {
  return doc.data.cover ? '--qmx-cover-image: url("' + doc.data.cover + '")' : undefined;
}
function formatDate(doc: (typeof docs)[number]) {
  const date = getDocDate(doc);
  return date ? date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }) : '持续整理';
}
---

<div class="qmx-home" data-home-shell data-random-links={JSON.stringify(randomLinks)}>
  <section class="qmx-home-hero" aria-labelledby="home-title">
    <div class="qmx-home-hero__copy">
      <span class="eyebrow">QMX / GAME KNOWLEDGE</span>
      <h1 id="home-title">把分散的经验，整理成可以继续阅读的路径。</h1>
      <p>这里记录游戏开发、引擎技术、框架设计和项目实践。先选一个内容分区，再进入完整专题。</p>
    </div>
    <div class="qmx-home-hero__index" aria-label="知识库概况">
      <div><strong>{docs.length}</strong><span>篇文章</span></div>
      <div><strong>{buckets.size}</strong><span>个专题</span></div>
      <div><strong>{featured.length}</strong><span>精选入口</span></div>
      <p>先选择内容入口，再向下浏览</p>
    </div>
  </section>

  <section class="home-discover" aria-labelledby="workspace-title">
    <div class="workspace-heading">
      <div><span class="eyebrow">DISCOVER / 内容入口</span><h2 id="workspace-title">选择一个入口开始</h2></div>
      <p>四个入口对应四种阅读方式。选择后这里只显示对应内容，列表内部再进行滚动和分页。</p>
    </div>
    <nav class="home-section-nav" aria-label="首页内容入口" role="tablist">
      <button type="button" role="tab" data-home-tab="topics" aria-controls="home-panel-topics" aria-selected="true" class="is-active"><strong>专题</strong><small>分类浏览全部专题</small><span>{topicCards.length.toString().padStart(2, '0')}</span></button>
      <button type="button" role="tab" data-home-tab="featured" aria-controls="home-panel-featured" aria-selected="false"><strong>精选</strong><small>适合从这里开始</small><span>{featured.length.toString().padStart(2, '0')}</span></button>
      <button type="button" role="tab" data-home-tab="latest" aria-controls="home-panel-latest" aria-selected="false"><strong>最近整理</strong><small>查看近期内容</small><span>{latest.length.toString().padStart(2, '0')}</span></button>
      <button type="button" role="tab" data-home-tab="random" aria-controls="home-panel-random" aria-selected="false"><strong>随机跳转</strong><small>换一篇继续阅读</small><span>↗</span></button>
    </nav>

    <section class="home-section" id="home-panel-topics" data-home-section="topics" aria-labelledby="topics-panel-title">
      <div class="section-heading"><div><span class="eyebrow">TOPICS / 专题地图</span><h3 id="topics-panel-title">按内容区域浏览</h3></div><span>{topicCards.length} 个专题</span></div>
      <div class="topic-filter" role="group" aria-label="专题分类">
        <button type="button" data-topic-filter="all" class="is-active"><strong>全部专题</strong><small>{topicCards.length} 个</small></button>
        {sections.map((section) => <button type="button" data-topic-filter={section.id}><strong>{section.title}</strong><small>{section.topics.length} 个</small></button>)}
      </div>
      <div class="section-scroll-frame topic-scroll-frame">
        <div class="topic-card-grid" data-topic-items>
          {topicCards.map((topic) => <article class="topic-card" data-topic-card data-topic-section={topic.sectionId}>
            <a class:list={['topic-card__cover', 'cover-' + (topic.entries[0]?.visualKey ?? 'default')]} href={base + '/series/' + encodeURIComponent(topic.collectionKey) + '/'} aria-label={`进入${topic.title}`}>
              {topic.entries[0]?.cover ? <img src={topic.entries[0].cover} alt={topic.entries[0].coverAlt} loading="lazy" /> : <span>{topic.title}</span>}
            </a>
            <div class="topic-card__body"><div class="topic-card__meta"><span>{topic.sectionTitle}</span><span>{topic.entries.length} 篇</span></div><h4>{topic.title}</h4><ol>{topic.entries.slice(0, 4).map((entry) => <li><a href={entry.href}>{entry.title}</a></li>)}</ol><a class="topic-card__cta" href={base + '/series/' + encodeURIComponent(topic.collectionKey) + '/'}>进入完整专题 <span aria-hidden="true">↗</span></a></div>
          </article>)}
        </div>
      </div>
      <div class="section-pagination" data-topic-pagination><button type="button" data-topic-prev disabled>上一页</button><span data-topic-page>第 1 / 1 页</span><button type="button" data-topic-next>下一页</button></div>
    </section>

    <section class="home-section" id="home-panel-featured" hidden data-home-section="featured" aria-labelledby="featured-panel-title">
      <div class="section-heading"><div><span class="eyebrow">START HERE / 从这里开始</span><h3 id="featured-panel-title">精选内容</h3></div><span>适合首次进入</span></div>
      <div class="section-scroll-frame"><div class="featured-grid">
        {featured.map((doc, index) => <a class:list={['feature-card', { 'feature-card--lead': index === 0 }]} href={getDocHref(doc, base)}>
          <div class:list={['content-cover', 'cover-' + getDocVisualKey(doc)]} style={coverStyle(doc)}>{doc.data.cover ? <img src={doc.data.cover} alt={doc.data.coverAlt ?? ''} loading="lazy" /> : <span aria-hidden="true">{displaySeries(doc)}</span>}<span class="content-cover__label">{index === 0 ? '编辑推荐' : '精选入口'}</span></div>
          <div class="feature-card__body"><div class="card-meta"><span>{displaySeries(doc)}</span><span>{formatDate(doc)}</span></div><h4>{doc.data.title}</h4>{doc.data.description && <p>{doc.data.description}</p>}<span class="card-link">开始阅读 <span aria-hidden="true">↗</span></span></div>
        </a>)}
      </div></div>
    </section>

    <section class="home-section" id="home-panel-latest" hidden data-home-section="latest" aria-labelledby="latest-panel-title">
      <div class="section-heading"><div><span class="eyebrow">LATEST / 最近整理</span><h3 id="latest-panel-title">最近值得继续读的内容</h3></div><span>按日期排序</span></div>
      <div class="section-scroll-frame"><div class="latest-list">
        {latest.map((doc) => <a class="latest-item" href={getDocHref(doc, base)}><span class:list={['latest-item__mark', 'cover-' + getDocVisualKey(doc)]} aria-hidden="true"></span><span class="latest-item__main"><strong>{doc.data.title}</strong><small>{displaySeries(doc)} · {doc.data.description ?? '查看文章内容与相关资料。'}</small></span><time datetime={getDocDate(doc)?.toISOString()}>{formatDate(doc)}</time></a>)}
      </div></div>
    </section>

    <section class="home-section random-section" id="home-panel-random" hidden data-home-section="random" aria-labelledby="random-panel-title">
      <div class="random-panel"><div class="random-panel__copy"><span class="eyebrow">RANDOM / 随机跳转</span><h3 id="random-panel-title">让知识库替你选一篇</h3><p>适合不知道从哪里开始时使用。每次点击都会从现有文章中换一个入口。</p><div class="random-panel__actions"><a id="random-target" class="random-panel__target" href={featured[0] ? getDocHref(featured[0], base) : base + '/'}><strong>{featured[0]?.data.title ?? '打开一篇文章'}</strong><small>{featured[0] ? displaySeries(featured[0]) : '知识库'}</small></a><button type="button" id="random-again">换一篇 <span aria-hidden="true">↗</span></button></div></div><div class="random-panel__mark" aria-hidden="true">↗</div></div>
    </section>
  </section>
</div>

<script>
  const shell = document.querySelector('[data-home-shell]');
  if (shell) {
    const tabs = [...shell.querySelectorAll('[data-home-tab]')];
    const panels = [...shell.querySelectorAll('[data-home-section]')];
    const validKeys = ['topics', 'featured', 'latest', 'random'];
    const selectPanel = (key, updateHash = true, scroll = false) => {
      if (!validKeys.includes(key)) return;
      tabs.forEach((tab) => {
        const active = tab.dataset.homeTab === key;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      panels.forEach((panel) => {
        const active = panel.dataset.homeSection === key;
        panel.classList.toggle('is-active', active);
        panel.toggleAttribute('hidden', !active);
      });
      if (updateHash) history.replaceState(null, '', `${location.pathname}${location.search}#home-panel-${key}`);
      if (scroll) document.querySelector('.home-discover')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const hashKey = location.hash.match(/^#home-panel-(topics|featured|latest|random)$/)?.[1] ?? 'topics';
    selectPanel(hashKey, false, Boolean(location.hash));
    shell.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-home-tab]') : null;
      if (target) selectPanel(target.dataset.homeTab, true, true);
    });
    window.addEventListener('hashchange', () => {
      const key = location.hash.match(/^#home-panel-(topics|featured|latest|random)$/)?.[1];
      if (key) selectPanel(key, false, true);
    });

    const topicCards = [...shell.querySelectorAll('[data-topic-card]')];
    const topicFilters = [...shell.querySelectorAll('[data-topic-filter]')];
    const topicPage = shell.querySelector('[data-topic-page]');
    const topicPrev = shell.querySelector('[data-topic-prev]');
    const topicNext = shell.querySelector('[data-topic-next]');
    let activeTopicFilter = 'all';
    let activeTopicPage = 1;
    const pageSize = 4;
    const updateTopicPage = () => {
      const filtered = topicCards.filter((card) => activeTopicFilter === 'all' || card.dataset.topicSection === activeTopicFilter);
      const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
      activeTopicPage = Math.min(activeTopicPage, pageCount);
      const visible = new Set(filtered.slice((activeTopicPage - 1) * pageSize, activeTopicPage * pageSize));
      topicCards.forEach((card) => card.toggleAttribute('hidden', !visible.has(card)));
      topicFilters.forEach((filter) => filter.classList.toggle('is-active', filter.dataset.topicFilter === activeTopicFilter));
      if (topicPage) topicPage.textContent = `第 ${activeTopicPage} / ${pageCount} 页`;
      if (topicPrev) topicPrev.disabled = activeTopicPage <= 1;
      if (topicNext) topicNext.disabled = activeTopicPage >= pageCount;
    };
    topicFilters.forEach((filter) => filter.addEventListener('click', () => { activeTopicFilter = filter.dataset.topicFilter; activeTopicPage = 1; updateTopicPage(); }));
    topicPrev?.addEventListener('click', () => { activeTopicPage -= 1; updateTopicPage(); });
    topicNext?.addEventListener('click', () => { activeTopicPage += 1; updateTopicPage(); });
    updateTopicPage();

    const links = JSON.parse(shell.dataset.randomLinks ?? '[]');
    const target = shell.querySelector('#random-target');
    const again = shell.querySelector('#random-again');
    again?.addEventListener('click', () => {
      if (!links.length || !target) return;
      const item = links[Math.floor(Math.random() * links.length)];
      target.href = item.href;
      target.querySelector('strong').textContent = item.title;
      target.querySelector('small').textContent = item.series;
    });
  }
</script>

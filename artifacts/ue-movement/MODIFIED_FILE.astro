---
import { getCollection } from 'astro:content';
import '../styles/home.css';

// 直接按真实目录生成预览，新增文章无需维护第二份首页链接清单。
const docs = (await getCollection('docs')).filter((doc) => /^(knowledge|projects|guide)\//.test(doc.id));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [
  { id: 'language', title: '语言与内存', description: 'C#、面向对象、运行时与内存管理。', folders: ['csharp速通', 'csharp与unity内存基础', 'csharp底层专栏', '面向对象串讲'] },
  { id: 'unity', title: 'Unity 与 ECS', description: '编辑器基础、Job、Burst、Entities 与工厂游戏实现。', folders: ['unity-job与burst', 'ecs学习', '认识unity'] },
  { id: 'unreal', title: 'Unreal Engine', description: '从引擎源码到 GASP 蓝图，研究 CMC、Mover 与角色运动动画。', folders: ['ue专栏'] },
  { id: 'source', title: '源码研究', description: 'Minecraft 世界生成与消失的光芒系统拆解。', folders: ['minecraft源码学习', '消失的光芒逆向学习'] },
  { id: 'engineering', title: '热更新与工程', description: '资源管理、AssetBundle、Addressables 与代码热更。', folders: ['unity热更新专栏'] },
  { id: 'reference', title: '工具与知识速查', description: 'Git 协作、开发工具、基础知识与学习记录。', folders: ['git使用指南', '工具', '八股', '自我忏悔'] },
  { id: 'projects', title: '项目与使用指南', description: '项目介绍、实践记录以及知识库的使用与维护。', folders: ['projects', 'guide'] },
];
const labels: Record<string, string> = {
  'ue专栏': 'UE 专栏 · 运动系统',
  'csharp速通': 'C# 速通', 'csharp与unity内存基础': 'C# 与 Unity 内存基础', 'csharp底层专栏': 'C# 底层专栏',
  'unity-job与burst': 'Unity Job、Burst 与 Entities', 'ecs学习': 'ECS 学习与工厂游戏',
  '认识unity': '认识 Unity', 'minecraft源码学习': 'Minecraft 源码学习',
  'unity热更新专栏': 'Unity 热更新专栏', 'git使用指南': 'Git 使用指南',
  '八股': '基础知识速查', '自我忏悔': '学习规划与复盘', projects: '项目文章', guide: '使用指南',
};
const buckets = new Map<string, typeof docs>();
for (const doc of docs) {
  const parts = doc.id.split('/');
  const folder = parts[0] === 'knowledge' ? parts[1] : parts[0];
  const entries = buckets.get(folder) ?? [];
  entries.push(doc);
  buckets.set(folder, entries);
}
// 未登记的新专题放入速查区，保证首页覆盖全部文档。
const assigned = new Set(categories.flatMap((category) => category.folders));
for (const folder of buckets.keys()) if (!assigned.has(folder)) categories.find((category) => category.id === 'reference')!.folders.push(folder);
const sections = categories.map((category) => ({
  ...category,
  topics: category.folders.filter((folder) => buckets.has(folder)).map((folder) => {
    const entries = buckets.get(folder)!.sort((a, b) => (a.data.sidebar.order ?? 999) - (b.data.sidebar.order ?? 999) || a.id.localeCompare(b.id, 'zh-CN', { numeric: true }));
    return { title: labels[folder] ?? folder, entries: entries.map((entry) => ({ title: entry.data.title, href: `${base}/${entry.id}/` })) };
  }),
}));
---

<div class="qmx-home">
  <div class="home-summary" aria-label="知识库概况">
    <span><strong>{docs.length}</strong> 篇文档</span><span><strong>{buckets.size}</strong> 个专题</span>
    <span class="summary-note">按分类浏览 · 预览文章 · 直接跳转</span>
  </div>
  <section id="knowledge-overview" aria-labelledby="overview-title">
    <div class="section-heading"><div><span class="eyebrow">BROWSE / 内容导航</span><h2 id="overview-title">知识库里有什么？</h2></div><p>点击文章直接阅读，展开列表查看专题全部内容。</p></div>
    <nav class="category-nav" aria-label="知识分类">{sections.map((section) => <a href={`#${section.id}`}>{section.title}<span>{section.topics.reduce((count, topic) => count + topic.entries.length, 0)}</span></a>)}</nav>
    {sections.map((section, index) => <section class="topic-section" id={section.id} aria-labelledby={`${section.id}-title`}>
      <div class="section-heading"><div><span class="eyebrow">0{index + 1} /</span><h2 id={`${section.id}-title`}>{section.title}</h2></div><p>{section.description}</p></div>
      <div class="knowledge-grid">{section.topics.map((topic) => <article class="knowledge-card">
        <div class="card-meta"><span>专题</span><span>{topic.entries.length} 篇文章</span></div>
        <h3><a href={topic.entries[0].href}>{topic.title}</a></h3>
        <ul class="article-preview">{topic.entries.slice(0, 3).map((entry) => <li><a href={entry.href}><span>{entry.title}</span><span aria-hidden="true">↗</span></a></li>)}</ul>
        {topic.entries.length > 3 && <details class="article-list"><summary>查看其余 {topic.entries.length - 3} 篇文章</summary><ul>{topic.entries.slice(3).map((entry) => <li><a href={entry.href}>{entry.title}</a></li>)}</ul></details>}
      </article>)}</div>
    </section>)}
  </section>
</div>

+<path d="M322 177H350" stroke="#66758d" stroke-width="2" marker-end="url(#arrow)"/>
+<rect x="358" y="105" width="284" height="144" rx="12" fill="#e8f7f1" stroke="#176951" stroke-opacity=".3"/>
+<text x="374" y="137" font-size="20" font-weight="700" fill="#176951">C# class：b = a</text>
+<text x="374" y="170" font-size="17" fill="#23364e">复制引用</text>
+<text x="374" y="196" font-size="17" fill="#23364e">a 和 b 指向同一角色</text>
+<text x="374" y="222" font-size="17" fill="#23364e">b 修改后 a 能看到</text>
+<path d="M648 177H676" stroke="#66758d" stroke-width="2" marker-end="url(#arrow)"/>
+<rect x="684" y="105" width="284" height="144" rx="12" fill="#fff2df" stroke="#8c5315" stroke-opacity=".3"/>
+<text x="700" y="137" font-size="20" font-weight="700" fill="#8c5315">C# struct：b = a</text>
+<text x="700" y="170" font-size="17" fill="#23364e">复制字段</text>
+<text x="700" y="196" font-size="17" fill="#23364e">List 字段仍是共享引用</text>
+<text x="700" y="222" font-size="17" fill="#23364e">不保证全部数据独立</text>
+<rect x="32" y="281" width="284" height="144" rx="12" fill="#eaf2ff" stroke="#285caa" stroke-opacity=".3"/>
+<text x="48" y="313" font-size="20" font-weight="700" fill="#285caa">C++</text>
+<text x="48" y="346" font-size="17" fill="#23364e">作用域析构 / RAII</text>
+<text x="48" y="372" font-size="17" fill="#23364e">unique_ptr 独占拥有</text>
+<text x="48" y="398" font-size="17" fill="#23364e">析构不是自动 GC</text>
+<path d="M322 353H350" stroke="#66758d" stroke-width="2" marker-end="url(#arrow)"/>
+<rect x="358" y="281" width="284" height="144" rx="12" fill="#e8f7f1" stroke="#176951" stroke-opacity=".3"/>
+<text x="374" y="313" font-size="20" font-weight="700" fill="#176951">C#</text>
+<text x="374" y="346" font-size="17" fill="#23364e">GC 按可达性管理内存</text>
+<text x="374" y="372" font-size="17" fill="#23364e">using 安排 Dispose</text>
+<text x="374" y="398" font-size="17" fill="#23364e">终结器不是作用域析构</text>
+<path d="M648 353H676" stroke="#66758d" stroke-width="2" marker-end="url(#arrow)"/>
+<rect x="684" y="281" width="284" height="144" rx="12" fill="#fff2df" stroke="#8c5315" stroke-opacity=".3"/>
+<text x="700" y="313" font-size="20" font-weight="700" fill="#8c5315">Unity</text>
+<text x="700" y="346" font-size="17" fill="#23364e">还存在引擎原生对象</text>
+<text x="700" y="372" font-size="17" fill="#23364e">Destroy 与 GC 分开</text>
+<text x="700" y="398" font-size="17" fill="#23364e">注意事件解绑和池化复位</text>
+<text x="32" y="512" font-size="16" fill="#495b73">封装和契约的思考可以迁移；复制与生命周期规则必须重新确认。</text></g></svg>diff --git a/public/assets/oop/dispatch.svg b/public/assets/oop/dispatch.svg
